# Copy to .env and fill in. .env is git-ignored.
PORT=2002
DB_CONNECTION_STRING=mongodb://localhost:27017/foods
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated list of front-end origins allowed to call the API
# (leave empty in development to allow any origin)
CORS_ORIGIN=http://localhost:5173

# Passwords used by `npm run seed-db`
SEED_ADMIN_PASSWORD=change-me
SEED_USER_PASSWORD=change-me
# Seeding wipes the database. It refuses non-local databases unless this is true.
ALLOW_REMOTE_SEED=false
